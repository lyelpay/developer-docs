{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Lyel Pay",
  "colors": {
    "primary": "#0ECBB8",
    "light": "#5EEAD4",
    "dark": "#08313A"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F8FAF9",
      "dark": "#050E12"
    }
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication",
              "sandbox"
            ]
          },
          {
            "group": "SDKs",
            "pages": [
              "sdks/javascript",
              "sdks/node",
              "sdks/react"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/accept-payment",
              "guides/webhooks",
              "guides/errors"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Status",
          "href": "https://status.lyelpay.com",
          "icon": "signal"
        },
        {
          "anchor": "Community",
          "href": "https://discord.gg/lyelpay",
          "icon": "discord"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/logo-light.svg",
    "dark": "/logo/logo-dark.svg"
  },
  "footer": {
    "socials": {
      "x": "https://x.com/lyelpay",
      "linkedin": "https://linkedin.com/company/lyelpay"
    }
  }
}